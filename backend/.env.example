# 应用配置
APP_NAME=AI自媒体运营平台
DEBUG=true

# 数据库配置
# PostgreSQL（生产环境）:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/op_ai
# SQLite（开发环境，默认）:
DATABASE_URL=sqlite:///./op_ai.db

# JWT 密钥（生产环境请更换为随机字符串）
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM 配置
# 支持: openai / anthropic / local
LLM_PROVIDER=openai
LLM_MODEL=sensenova-6.8-flash-lite
LLM_API_KEY=sk-mAL5UEdKyRUIQ2DiOlkwu6fw3clYuSrD
LLM_API_BASE=https://token.sensenova.cn/v1

# 图片生成配置
# 支持: openai / local / mock（开发环境用 mock）
IMAGE_PROVIDER=mock

# 文件上传目录
UPLOAD_DIR=uploads
