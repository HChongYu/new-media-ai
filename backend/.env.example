# 应用配置
APP_NAME=AI自媒体运营平台
DEBUG=true

# 数据库配置
# PostgreSQL（生产环境）:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/op_ai
# SQLite（开发环境，默认）:
DATABASE_URL=sqlite:///./op_ai.db

# LangGraph 工作流 Checkpointer（人工中断/恢复的状态持久化）
# 留空则自动跟随 DATABASE_URL：
# - PostgreSQL 生产：直接复用上面的连接（自动去掉 +psycopg 后缀）
# - SQLite 开发：使用独立文件 langgraph_checkpoints.db，避免与业务库互锁
# LANGGRAPH_DB_URL=
# Checkpointer 后端开关：
# auto（默认，跟随上方数据库配置）/ memory（纯内存 mock，不依赖数据库，重启状态丢失）
# CHECKPOINTER_BACKEND=auto

# JWT 密钥（生产环境请更换为随机字符串）
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM 配置
# 支持: openai / anthropic / local / mock（mock 无需 API Key，返回内置假数据，仅用于本地开发/测试）
LLM_PROVIDER=openai
LLM_MODEL=sensenova-6.8-flash-lite
LLM_API_KEY=sk-mAL5UEdKyRUIQ2DiOlkwu6fw3clYuSrD
LLM_API_BASE=https://token.sensenova.cn/v1

# 图片生成配置
# 支持: sensenova（商汤日日新，复用上方 LLM 的 Key 和 Base URL）/ openai / local / mock
IMAGE_PROVIDER=sensenova
# 文生图模型（商汤 SenseNova U1 Fast，擅长配图/信息图）
IMAGE_MODEL=sensenova-u1-fast
# 如需独立的生图凭证可配置，留空则复用 LLM_API_BASE / LLM_API_KEY
# IMAGE_API_BASE=https://token.sensenova.cn/v1
# IMAGE_API_KEY=
# 图片是否带官方水印
IMAGE_WATERMARK=true
# local 模式：本地 Stable Diffusion WebUI 地址（启动时需添加 --api 参数）
SD_WEBUI_URL=http://127.0.0.1:7860

# 文件上传目录
UPLOAD_DIR=uploads

# 内容发布配置
# simulate: 模拟发布（开发默认，不产生真实平台链接）
# live: 对接真实平台 API（微信公众号需配置下方凭证）
PUBLISH_MODE=simulate
# 微信公众号凭证（live 模式必填，公众号后台「设置与开发」获取）
WECHAT_APPID=
WECHAT_APPSECRET=
# 可选：中控服务地址，返回 {"access_token": "..."}，用于多实例共享或规避 IP 白名单
# WECHAT_ACCESS_TOKEN_URL=
